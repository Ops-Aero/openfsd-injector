# Copy to .env and fill in. OPENFSD_* values override matching YAML keys.

# Host machine talking to a local opsaero-main stack:
OPENFSD_HOST=127.0.0.1
OPENFSD_PORT=6809
# openfsd web API (fsdweb). Not the Laravel site on :8000.
OPENFSD_API_BASE=http://127.0.0.1:8010
OPENFSD_CID=1
OPENFSD_PASSWORD=opsaeroadmin
# Optional: skip the API JWT call and send this token/password raw.
# OPENFSD_TOKEN=

# Docker injector talking to host-published OpsAero ports:
# OPENFSD_HOST=host.docker.internal
# OPENFSD_API_BASE=http://host.docker.internal:8010
