# Copy to .env and fill in. Values here override matching YAML keys
# when prefixed OPENFSD_.

OPENFSD_HOST=127.0.0.1
OPENFSD_PORT=6809
OPENFSD_API_BASE=http://127.0.0.1:8000
OPENFSD_CID=100000
OPENFSD_PASSWORD=changeme
# Optional: skip the API JWT call and send this token/password raw.
# OPENFSD_TOKEN=
