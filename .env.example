# Injector only. Do not copy this from opsaero-main.
#
# Copy to `.env` and fill in YOUR OWN values: `cp .env.example .env`.
# `.env` is git-ignored — never commit a filled-in copy.
#
# Create a dedicated ATIS identity (not CID 1, not Administrator) with the
# lowest network rating your stations need — S2 (3) for tower ATIS, at most
# C1 (5). Do not reuse the bootstrap admin account, and do not use any
# password that shipped with a server install.

# Same-host sidecar (FSD published on the host). For the opsaero compose
# network instead: OPENFSD_HOST=fsd and OPENFSD_API_BASE=http://fsdweb:8010
OPENFSD_HOST=host.docker.internal
OPENFSD_PORT=6809
OPENFSD_API_BASE=http://host.docker.internal:8010

# Required. Dedicated ATIS CID + password — never CID 1 / Administrator.
# The injector has no built-in credential and exits at startup with a
# clear error if neither OPENFSD_PASSWORD nor OPENFSD_TOKEN is set.
OPENFSD_CID=replace-with-your-own-cid
OPENFSD_PASSWORD=replace-with-your-own-password
# Optional pre-minted FSD JWT instead of a password:
# OPENFSD_TOKEN=replace-with-your-own-token
# Refuse rating 12 unless you deliberately set this:
# OPENFSD_ALLOW_ADMINISTRATOR=1

# Used when config.yaml has no stations list (config.yaml is the override).
ATIS_ICAOS=EGLL,EGKK
# tts in Docker when unset. Set none to stay silent.
# VOICE_BACKEND=tts

# Running the Python app on the host instead of Docker:
# OPENFSD_HOST=127.0.0.1
# OPENFSD_API_BASE=http://127.0.0.1:8010
